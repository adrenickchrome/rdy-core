# Each area test binary lists its test files; two branches that add tests merge both lines.
crates/rdy-qa/tests/*/main.rs merge=union
# The released dump fixtures are pinned by the hash of their bytes: never convert line endings.
crates/rdy-qa/fixtures/dump/* -text
# The sync batch vectors are pinned the same way.
crates/rdy-qa/fixtures/sync/* -text
# The diagram goldens are compared byte for byte on every host.
crates/rdy-diagram/tests/fixtures/** -text
# The native store fixtures are pinned by the hash of their bytes: FORMAT and expect.json are text, so never convert line endings.
crates/rdy-qa/fixtures/store/** -text
