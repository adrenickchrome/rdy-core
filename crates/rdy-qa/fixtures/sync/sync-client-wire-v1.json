    },
    {
      "design": "D-3TBYC",
      "step": "known, pull form"
    },
    {
      "design": "D-3TBYC",
      "step": "get"
    },
    {
      "design": "D-3TBYC, i-B40VF, D-Q0V1P, tb-KAZ3J",
